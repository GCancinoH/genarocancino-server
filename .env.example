# Gmail SMTP settings for Flask-Mail
# Gmail requires an App Password, not your normal account password.
# Create one in Google Account > Security > 2-Step Verification > App passwords.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=g.cancinoh@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SENDER_NAME=Sistema Ascenso
